# ===================================================
# SIP SUPPORT - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# 1. MongoDB Atlas Connection URI (Free M0 Cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sipsupport?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sipsupport?retryWrites=true&w=majority

# 2. NextAuth Configuration
# Generate a secure 32-byte secret using terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# The canonical URL of your site (Use http://localhost:3000 for local development, and your https://your-project.vercel.app for production)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# 3. GitHub OAuth Provider (https://github.com/settings/developers)
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# 4. Google OAuth Provider (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
